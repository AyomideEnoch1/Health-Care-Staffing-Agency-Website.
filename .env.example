# Production Environment
NODE_ENV=production
PORT=3000

# Hostinger MySQL Database (Replace u123456789 with your Hostinger account prefix)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_df_app
DB_PASSWORD=SecureProductionPassword_DoNotCommit
DB_NAME=u123456789_divine_fingers_db
DB_CONNECTION_LIMIT=10

# Security Tokens (Generate 64+ char random string via openssl rand -base64 48)
JWT_SECRET=production_random_cryptographic_key_min_64_characters_generated_via_openssl
JWT_EXPIRES_IN=8h

# Hostinger Server Resume Storage (Outside public_html)
UPLOAD_DIR=/home/u123456789/secure_uploads/resumes
MAX_FILE_SIZE_BYTES=10485760

# Hostinger SMTP Mail Delivery
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@divinefingershealthcare.ca
SMTP_PASS=HostingerEmailPasswordHere
AGENCY_ALERT_EMAIL=info@divinefingershealthcare.ca

# CORS Lock (Option B: Vercel Frontend domain + Custom domain)
ALLOWED_ORIGINS=https://divinefingershealthcare.ca,https://www.divinefingershealthcare.ca,https://health-care-staffing-agency-website.vercel.app
