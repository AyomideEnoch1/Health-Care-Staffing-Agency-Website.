# Application Mode & Port
NODE_ENV=development
PORT=3000

# Local MySQL Database (Docker or Native MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=df_app_user
DB_PASSWORD=local_app_dev_password_2026!
DB_NAME=divine_fingers_dev
DB_CONNECTION_LIMIT=5

# Admin JWT Secret & Expiry
JWT_SECRET=local_development_jwt_secret_must_be_over_64_characters_long_random_dev_only_2026
JWT_EXPIRES_IN=8h

# File Uploads (Local disk)
UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE_BYTES=10485760

# Local MailHog SMTP Interceptor
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev@divinefingers.local
SMTP_PASS=dev
AGENCY_ALERT_EMAIL=info@divinefingershealthcare.ca

# CORS (Allow local dev ports and Vercel dev preview)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173
