# ==============================================================================
# Divine Fingers Healthcare Services Inc. — Environment Configuration Template
# ==============================================================================
# SECURITY INSTRUCTIONS:
# 1. Never commit the actual .env file to Git.
# 2. On production Hostinger VPS, protect this file:
#      chown app:app /var/www/divine-fingers/.env
#      chmod 600 /var/www/divine-fingers/.env
# 3. Generate distinct cryptographic secrets using: openssl rand -hex 32
# ==============================================================================

# Application Runtime & Proxy
NODE_ENV=production
PORT=3000
APP_URL=https://divinefingershealthcare.ca
APP_BASE_URL=https://divinefingershealthcare.ca
TRUST_PROXY_HOPS=1
RUN_EMBEDDED_DAEMON=false

# Production MySQL Database (Least-Privilege App User)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=divine_fingers_prod
DB_USER=df_app_user
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_GENERATE_VIA_OPENSSL
DB_CONNECTION_LIMIT=15

# Session & JWT Cryptography (MUST be distinct, min 64 hex characters / 32 bytes)
# Generate: openssl rand -hex 32
JWT_ADMIN_SECRET=REPLACE_WITH_UNIQUE_RANDOM_ADMIN_JWT_SECRET_32_BYTES_HEX
JWT_USER_SECRET=REPLACE_WITH_UNIQUE_RANDOM_USER_JWT_SECRET_32_BYTES_HEX
JWT_EXPIRES_IN=8h

# Data-at-Rest & Outbox Field Encryption (AES-256-GCM keys)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_ENCRYPTION_KEY_FOR_SENSITIVE_PHI
OUTBOX_ENC_KEY=REPLACE_WITH_64_HEX_CHAR_ENCRYPTION_KEY_FOR_OUTBOX_EMAILS

# Webhook Authentication
# Generate: openssl rand -hex 32
EMAIL_WEBHOOK_SECRET=REPLACE_WITH_HMAC_SECRET_FOR_DELIVERY_WEBHOOKS

# File Upload Vault (Stored outside web root with random names)
UPLOAD_DIR=/var/www/divine-fingers/uploads/resumes
CREDENTIALS_UPLOAD_DIR=/var/www/divine-fingers/uploads/credentials
MAX_FILE_SIZE_BYTES=15728640
CLAMAV_ENABLED=true

# Hostinger SMTP Relay Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@notify.divinefingershealthcare.ca
SMTP_PASS=REPLACE_WITH_HOSTINGER_MAILBOX_PASSWORD
NOTIFY_DOMAIN=notify.divinefingershealthcare.ca
SYSTEM_FROM_EMAIL="Divine Fingers Healthcare" <no-reply@notify.divinefingershealthcare.ca>
AGENCY_ALERT_EMAIL=info@divinefingershealthcare.ca

# Outbox Worker Tuning
MAIL_POLL_MS=5000
MAIL_BATCH=10
MAIL_MAX_PER_MIN=25
MAIL_DAILY_CAP=1000
MAIL_MAX_ATTEMPTS=6

# Cloudflare Bot Defense
CLOUDFLARE_TURNSTILE_SECRET_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SECRET_KEY

# Strict CORS Whitelist (Comma-separated exact origins)
ALLOWED_ORIGINS=https://divinefingershealthcare.ca,https://www.divinefingershealthcare.ca

# Backup Cryptography
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BACKUP_ENCRYPTION_KEY
BACKUP_GPG_RECIPIENT=security@divinefingershealthcare.ca
