# ==============================================================================
# Divine Fingers Healthcare Services Inc. - Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production and supply production values.
# NEVER commit real .env files, certificates, or passwords to version control.

# ── Application Environment & Networking ─────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://www.divinefingershealthcare.ca
ALLOWED_ORIGINS=https://www.divinefingershealthcare.ca
TRUST_PROXY_HOPS=1
RUN_EMBEDDED_DAEMON=false

# ── Managed MySQL Database (Aiven MySQL 8.x / defaultdb) ───────────────────────
DB_HOST=mysql-xxxx-xxxx.aivencloud.com
DB_PORT=25060
DB_USER=avnadmin
DB_PASSWORD=your_aiven_database_password
DB_NAME=defaultdb
DB_CONNECTION_LIMIT=5

# Aiven Managed Database CA Certificate (PEM string with escaped newlines \n)
# Example: "-----BEGIN CERTIFICATE-----\nMIIB...==\n-----END CERTIFICATE-----"
DB_CA_CERT="-----BEGIN CERTIFICATE-----\nPASTE_AIVEN_CA_CERT_HERE\n-----END CERTIFICATE-----"

# ── Cryptographic Secrets & Session Tokens (Min 32 characters, distinct keys) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_SECRET=generate_strong_64_char_hex_for_admin_jwt_secret_here
JWT_USER_SECRET=generate_distinct_strong_64_char_hex_for_user_jwt_secret_here
JWT_EXPIRES_IN=8h
ENCRYPTION_KEY=generate_strong_32_byte_hex_key_for_aes_256_gcm_storage
OUTBOX_ENC_KEY=generate_strong_32_byte_hex_key_for_outbox_envelope_encryption

# ── Outbound Email: HTTPS API (Recommended, Port 443 unblocked) or SMTP ───────
# Option A: HTTPS API (Resend or Brevo - Recommended on Render/Cloud hosts)
# Brevo free tier: 300 emails/day | Resend free tier: 3,000 emails/month (100/day)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Divine Fingers Healthcare" <onboarding@resend.dev>
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
MAIL_DRIVER=https

# Option B: Traditional SMTP Relay (Fallback if not using HTTPS API)
SMTP_HOST=smtp.relay.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@divinefingershealthcare.ca
SMTP_PASS=your_production_smtp_password
SYSTEM_FROM_EMAIL="Divine Fingers Healthcare" <no-reply@divinefingershealthcare.ca>
AGENCY_ALERT_EMAIL=intake@divinefingershealthcare.ca
EMAIL_WEBHOOK_SECRET=your_inbound_bounce_webhook_signing_secret

# Mail Rate Limiting & Queue Tuning
MAIL_DAILY_CAP=5000
MAIL_MAX_PER_MIN=60
MAIL_BATCH=20
MAIL_MAX_ATTEMPTS=5
MAIL_POLL_MS=10000

# ── File Uploads & Local Scratch Storage ─────────────────────────────────────
UPLOAD_DIR=./uploads/resumes
AVATAR_UPLOAD_DIR=./uploads/avatars
CREDENTIALS_UPLOAD_DIR=./uploads/credentials
CONTRACTS_UPLOAD_DIR=./uploads/contracts
MAX_FILE_SIZE_BYTES=10485760
CLAMAV_ENABLED=false

# ── Bot Protection & SMS Relay (Optional) ────────────────────────────────────
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_optional_turnstile_secret_key
SMS_PROVIDER=twilio
SMS_API_KEY=your_optional_sms_api_key
SMS_GATEWAY_URL=https://api.twilio.com/2010-04-01/
SMS_SENDER_ID=DFHealth
