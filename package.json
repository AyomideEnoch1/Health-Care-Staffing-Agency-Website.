{
  "name": "divine-fingers-backend",
  "version": "1.0.0",
  "description": "Secure Node.js and MySQL Backend for Divine Fingers Healthcare Services Inc.",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db && node scripts/seedAdmin.js",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^6.9.14",
    "qrcode": "^1.5.4",
    "tiny-csrf": "^1.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.4"
  }
}
